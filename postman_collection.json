{
  "info": {
    "name": "Menen Crafts API",
    "_postman_id": "menen-crafts-api-collection",
    "description": "Collection of requests to exercise the Menen Crafts backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongP@ssw0rd\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('token', json.access_token);",
                  "  pm.environment.set('userId', json.user?.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongP@ssw0rd\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"id\": \"{{userId}}\" }"
            },
            "url": "{{baseUrl}}/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"UserP@ss1\",\n  \"firstName\": \"User\",\n  \"lastName\": \"One\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/:id"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"firstName\": \"Updated\" }" },
            "url": "{{baseUrl}}/users/:id"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/:id"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Ceramics\", \"description\": \"Handmade ceramic items\" }"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Get Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories" }
        },
        {
          "name": "Get Category by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories/:id" }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"description\": \"Updated description\" }" },
            "url": "{{baseUrl}}/categories/:id"
          }
        },
        {
          "name": "Delete Category",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/categories/:id" }
        }
      ]
    },
    {
      "name": "Crafts",
      "item": [
        { "name": "Get Crafts", "request": { "method": "GET", "url": "{{baseUrl}}/crafts" } },
        { "name": "Get Craft by ID", "request": { "method": "GET", "url": "{{baseUrl}}/crafts/:id" } },
        {
          "name": "Create Craft",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('craftId', json.id);",
                  "pm.test('response has id and title', () => { pm.expect(json).to.have.property('id'); pm.expect(json).to.have.property('title'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Handmade Vase\",\n  \"description\": \"A beautiful handmade vase.\",\n  \"price\": 49.99,\n  \"stock\": 10,\n  \"isAvailable\": true,\n  \"categoryIds\": [1],\n  \"images\": [\"vase1.jpg\",\"vase2.jpg\"],\n  \"specifications\": { \"material\": \"clay\", \"height_cm\": 25 }\n}"
            },
            "url": "{{baseUrl}}/crafts"
          }
        },
        {
          "name": "Update Craft",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"price\": 44.99 }" },
            "url": "{{baseUrl}}/crafts/:id"
          }
        },
        {
          "name": "Delete Craft",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/crafts/:id"
          }
        },
        { "name": "Get Crafts by Artisan", "request": { "method": "GET", "url": "{{baseUrl}}/crafts/artisan/:artisanId" } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('orderId', json.id || json.orderId || json.uuid);",
                  "pm.test('has items array', () => { pm.expect(json).to.have.property('items'); pm.expect(json.items).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"craftId\": 1, \"quantity\": 2 }],\n  \"shippingAddress\": \"123 Main St, City\",\n  \"billingAddress\": \"123 Main St, City\",\n  \"notes\": \"Leave at door\"\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        { "name": "Get All Orders", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/orders" } },
        { "name": "Get My Orders", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/orders/my-orders" } },
        { "name": "Get Order by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/orders/:id" } },
        {
          "name": "Update Order",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"quantity\": 3 }" },
            "url": "{{baseUrl}}/orders/:id"
          }
        },
        {
          "name": "Update Order Status (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"SHIPPED\" }" },
            "url": "{{baseUrl}}/orders/:id/status"
          }
        },
        {
          "name": "Add Tracking Number (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"trackingNumber\": \"TRACK12345\" }" },
            "url": "{{baseUrl}}/orders/:id/tracking"
          }
        },
        { "name": "Delete Order", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/orders/:id" } }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        { "name": "Get Reviews by Craft", "request": { "method": "GET", "url": "{{baseUrl}}/reviews/craft/:craftId" } },
        {
          "name": "Create Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('reviewId', json.id);",
                  "pm.test('rating between 1 and 5', () => { pm.expect(json.rating).to.be.within(1,5); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"craftId\": 1, \"rating\": 5, \"comment\": \"Amazing craftsmanship\" }" },
            "url": "{{baseUrl}}/reviews"
          }
        },
        { "name": "Update Review", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{ \"rating\": 4 }" }, "url": "{{baseUrl}}/reviews/:id" } },
        { "name": "Delete Review", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/reviews/:id" } }
      ]
    }
  ]
}
